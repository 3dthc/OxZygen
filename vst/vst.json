{
  "name": "OxZygen",
  "vendor": "oxzygen",
  "uid": "OxZy",
  "version": 740,
  "so": "oxzygen.so",
  "params": "params.json",
  "layout": "skin/layout.conf",
  "art": "html",
  "defines": {
    "VST3_REPLACES_VST2": 1,
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_NO_UPDATE": 1,
    "MODULE_SUBDIR": "\"samples\""
  },
  "build": {
    "root": ".",
    "sources": [
      "engine.c"
    ],
    "cflags": [
      "-O3",
      "-ffast-math",
      "-fno-finite-math-only"
    ],
    "libs": [
      "-lm"
    ],
    "cflags_arm": [
      "-mfpu=neon-vfpv4"
    ],
    "cflags_aarch64": []
  },
  "targets": [
    "armv7",
    "aarch64"
  ],
  "au_vendor": "3dthc",
  "au_manufacturer": "3Dth",
  "programs": {
    "param": "preset"
  }
}
